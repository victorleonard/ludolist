{
  "kind": "collectionType",
  "collectionName": "list_items",
  "info": {
    "singularName": "list-item",
    "pluralName": "list-items",
    "displayName": "List Item"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "is_checked": {
      "type": "boolean",
      "default": false
    },
    "list": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::list.list",
      "inversedBy": "items",
      "required": true
    },
    "family": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::family.family",
      "required": true
    },
    "created_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member"
    },
    "checked_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member"
    }
  }
}
