{
  "kind": "collectionType",
  "collectionName": "tasks",
  "info": {
    "singularName": "task",
    "pluralName": "tasks",
    "displayName": "Task"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "enumeration",
      "enum": ["low", "medium", "high", "urgent"],
      "default": "medium"
    },
    "due_date": {
      "type": "date"
    },
    "created_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member"
    },
    "assigned_to": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member"
    },
    "family": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::family.family",
      "inversedBy": "tasks"
    }
  }
}
