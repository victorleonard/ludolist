{
  "kind": "collectionType",
  "collectionName": "members",
  "info": {
    "singularName": "member",
    "pluralName": "members",
    "displayName": "Member"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4
    },
    "ratings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::rating.rating",
      "mappedBy": "member"
    },
    "player_scores": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::player-score.player-score",
      "mappedBy": "member"
    },
    "book_readings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-reading.book-reading",
      "mappedBy": "member"
    },
    "books_added": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book.book",
      "mappedBy": "added_by",
      "description": "Livres ajoutés à la collection par ce membre"
    }
  }
}
